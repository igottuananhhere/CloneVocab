# ---------------------------------------------------------------------------
# Bien moi truong cho backend (NestJS), Prisma CLI va script seed.
# Bien cho frontend nam o apps/web/.env.example - Next.js chi doc file .env trong
# thu muc cua chinh no.
#
# Cach dung:  cp .env.example .env
# Cac gia tri duoi day la mac dinh cua Supabase CLI local. Chay `pnpm supabase:status`
# de lay dung key neu chung khac.
# ---------------------------------------------------------------------------

# --- Postgres (Prisma) ---
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"

# --- Supabase ---
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY="thay-bang-anon-key-tu-supabase-status"
SUPABASE_SERVICE_ROLE_KEY="thay-bang-service-role-key-tu-supabase-status"
# Bat buoc voi Supabase local (JWT ky bang HS256).
# Voi project cloud dung khoa bat doi xung: de TRONG, API se tu chuyen sang JWKS.
SUPABASE_JWT_SECRET="super-secret-jwt-token-with-at-least-32-characters-long"

# --- apps/api (NestJS) ---
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# --- Google OAuth (tuy chon) ---
# Ba bien nay duoc supabase/config.toml doc truc tiep, khong phai sua file cau hinh nao.
# Bat: dat GOOGLE_OAUTH_ENABLED=true, dien hai bien con lai, roi chay lai
# `pnpm supabase:stop && pnpm supabase:start`.
#
# GOOGLE_OAUTH_ENABLED phai luon la "true" hoac "false". De trong se lam
# `supabase start` bao ProjectConfigParseError.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=""
GOOGLE_SECRET=""
