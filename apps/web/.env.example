# ---------------------------------------------------------------------------
# Bien moi truong cho Next.js.  Cach dung:  cp .env.example .env.local
# Chi dat o day nhung bien frontend that su can - moi bien NEXT_PUBLIC_* deu duoc
# nhung thang vao bundle gui xuong trinh duyet, khong bao gio dat bi mat o day.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="thay-bang-anon-key-tu-supabase-status"
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Dung cho canonical URL va the Open Graph. Doi thanh domain that khi len production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
